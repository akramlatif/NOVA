# ==============================================================================
# NOVA — Environment configuration template
# ------------------------------------------------------------------------------
# Copy this file to .env and fill in your real values:
#     copy .env.example .env
#
# .env is git-ignored. NEVER commit real credentials. NEVER share them.
# NOVA is local-first: most of these are optional for early phases.
# ==============================================================================

# ---- Ollama (local AI runtime) -----------------------------------------------
# Phase 2+: the local model NOVA talks to. Chosen for 8 GB RAM, no GPU.
# Recommended: llama3.2:3b  (~2 GB) — safe with Windows 11 running.
#              qwen2.5:3b  (~1.9 GB) — strong alternative, good reasoning.
# Do NOT use 7B+ models on this machine.
NOVA_LLM_MODEL=llama3.2:3b

# Ollama server address. Default install listens here. Change only if you
# moved the service.
NOVA_OLLAMA_HOST=http://127.0.0.1:11434

# ---- Storage locations (keep on D: where practical) ---------------------------
# Ollama model storage. Set the OLLAMA_MODELS env-var to this path before
# installing models so weights land on D:, not C:.
NOVA_MODELS_DIR=D:\NOVA\models

# NOVA data and logs (SQLite DBs, audit log, runtime logs)
NOVA_DATA_DIR=D:\NOVA\data
NOVA_LOGS_DIR=D:\NOVA\logs

# ---- Security ------------------------------------------------------------------
# NOVA binds ONLY to localhost. Do not change this to 0.0.0.0 — that would
# expose computer-control endpoints to your network. (Enforced in Phase 7.)
NOVA_BIND_HOST=127.0.0.1
NOVA_BIND_PORT=8000

# Optional: a token the frontend must present to the backend. If left empty in
# early phases, NOVA runs on the same-machine trust model. A real value will
# be required once the web UI ships (Phase 8).
NOVA_API_TOKEN=

# ---- Future phases (unused now — do not fill in yet) ----------------------------
# Web search API key (Phase 4)       : e.g. DuckDuckGo needs no key
# Speech-to-text key (Phase 6)       : local whisper.cpp planned — no cloud key
# Voice output config (Phase 6)     : Windows SAPI voices, local
